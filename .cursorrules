### Animation Guidelines
```typescript
// All animations should be:
// - Slow and gentle (never snappy or bouncy)
// - Ease-out or ease-in-out (never linear or ease-in)
// - Subtle (small movements, gentle fades)

export const animation = {
  // Durations (ms)
  duration: {
    instant: 100,
    fast: 200,
    normal: 300,
    slow: 500,
    gentle: 800,
  },
  
  // Easings - prefer gentle curves
  easing: {
    gentle: [0.4, 0, 0.2, 1], // Ease out
    smooth: [0.4, 0, 0.6, 1], // Ease in-out
    soft: [0.22, 1, 0.36, 1], // Ease out expo (very gentle)
  },
  
  // Spring configs for Reanimated
  spring: {
    gentle: {
      damping: 20,
      stiffness: 90,
      mass: 1,
    },
    soft: {
      damping: 25,
      stiffness: 70,
      mass: 1,
    },
  },
} as const;

// NEVER use:
// - Bouncy springs
// - Fast/snappy animations
// - Jarring transitions
// - Excessive motion
```

### Haptics
```typescript
// Use sparingly and gently
export const haptics = {
  // Light feedback for selections
  selection: 'selection', // Haptics.selectionAsync()
  
  // For completing actions
  success: 'notificationSuccess', // Haptics.notificationAsync(Success)
  
  // For errors (use rarely)
  error: 'notificationWarning', // Haptics.notificationAsync(Warning)
  
  // NEVER use heavy/rigid impacts
} as const;
```

