## 5. TECHNICAL STANDARDS

### TypeScript Conventions
```typescript
// Use strict TypeScript
// No `any` types - use `unknown` and narrow
// Prefer interfaces over types for objects
// Use const assertions for literals
// Always define return types for functions

// Good
interface CheckIn {
  id: string;
  timestamp: Date;
  mood: MoodLevel;
  notes?: string;
}

const createCheckIn = (mood: MoodLevel, notes?: string): CheckIn => {
  return {
    id: generateId(),
    timestamp: new Date(),
    mood,
    notes,
  };
};

// Bad
const createCheckIn = (mood: any, notes: any) => {
  return { id: generateId(), timestamp: new Date(), mood, notes };
};
```

### File Naming
- Components: `PascalCase.tsx` (e.g., `MoodPicker.tsx`)
- Hooks: `useCamelCase.ts` (e.g., `useCheckIn.ts`)
- Utilities: `camelCase.ts` (e.g., `formatDate.ts`)
- Types: `camelCase.types.ts` (e.g., `checkIn.types.ts`)
- Constants: `camelCase.constants.ts` (e.g., `colors.constants.ts`)
- Stores: `camelCaseStore.ts` (e.g., `checkInStore.ts`)

### Component Structure
```typescript
// 1. Imports (external, then internal, then types)
import { View, Text } from 'react-native';
import Animated from 'react-native-reanimated';

import { Button } from '@/components/Button';
import { useTheme } from '@/hooks/useTheme';

import type { MoodLevel } from '@/types/mood.types';

// 2. Types/Interfaces
interface MoodPickerProps {
  value: MoodLevel;
  onChange: (mood: MoodLevel) => void;
  disabled?: boolean;
}

// 3. Component
export const MoodPicker = ({ value, onChange, disabled = false }: MoodPickerProps) => {
  // Hooks first
  const theme = useTheme();
  
  // State
  const [isOpen, setIsOpen] = useState(false);
  
  // Effects
  useEffect(() => {
    // ...
  }, []);
  
  // Handlers
  const handleSelect = (mood: MoodLevel) => {
    onChange(mood);
    setIsOpen(false);
  };
  
  // Render
  return (
    <View>
      {/* ... */}
    </View>
  );
};
```

### State Management (Zustand)
```typescript
import { create } from 'zustand';
import { persist, createJSONStorage } from 'zustand/middleware';
import AsyncStorage from '@react-native-async-storage/async-storage';

interface CheckInState {
  checkIns: CheckIn[];
  addCheckIn: (checkIn: Omit<CheckIn, 'id' | 'timestamp'>) => void;
  getCheckInsByDate: (date: Date) => CheckIn[];
}

export const useCheckInStore = create<CheckInState>()(
  persist(
    (set, get) => ({
      checkIns: [],
      addCheckIn: (data) => {
        const checkIn: CheckIn = {
          id: generateId(),
          timestamp: new Date(),
          ...data,
        };
        set((state) => ({ checkIns: [...state.checkIns, checkIn] }));
      },
      getCheckInsByDate: (date) => {
        return get().checkIns.filter(c => isSameDay(c.timestamp, date));
      },
    }),
    {
      name: 'ollie-checkins',
      storage: createJSONStorage(() => AsyncStorage),
    }
  )
);
```

### Import Aliases
Configure in `tsconfig.json`:
```json
{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@features/*": ["src/features/*"],
      "@hooks/*": ["src/hooks/*"],
      "@stores/*": ["src/stores/*"],
      "@utils/*": ["src/utils/*"],
      "@constants/*": ["src/constants/*"],
      "@types/*": ["src/types/*"]
    }
  }
}
```

### Error Handling
```typescript
// Use Result pattern for operations that can fail
type Result<T, E = Error> = 
  | { success: true; data: T }
  | { success: false; error: E };

// Wrap async operations
const safeAsync = async <T>(
  operation: () => Promise<T>
): Promise<Result<T>> => {
  try {
    const data = await operation();
    return { success: true, data };
  } catch (error) {
    return { success: false, error: error as Error };
  }
};
```

